{
  "name": "@unhosted-ai/wallet-js",
  "version": "0.0.1",
  "description": "Payer-side helpers for unhosted public mode: canonical-JSON + Ed25519 over the same wire shape the daemon expects.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "keywords": ["unhosted", "ed25519", "payments", "wallet", "p2p"],
  "author": "Ankur Sinha",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/unhosted-ai/unhosted-payments.git",
    "directory": "wallet-js"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.0",
    "@noble/hashes": "^1.7.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=20"
  }
}
